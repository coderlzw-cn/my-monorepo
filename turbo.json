{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["typecheck", "lint", "format:check", "test"]
    },
    "typecheck": {},
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "test": {},
    "test:watch": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "test:cov": {
      "outputs": ["coverage/**"]
    },
    "test:debug": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:debug": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "start:debug": {
      "cache": false,
      "persistent": true
    },
    "start:prod": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "outputs": ["src/generated/prisma/**"]
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
