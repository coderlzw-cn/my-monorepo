{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* React 应用与组件库共用的浏览器、JSX 和 Bundler 配置 */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "erasableSyntaxOnly": true
  }
}
